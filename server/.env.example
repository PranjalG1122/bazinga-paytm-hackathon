PORT=5000
NODE_ENV=development

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://your-public-host.example/api/telegram/webhook
TELEGRAM_DEFAULT_CHAT_ID=

# Hermes API server (keep it bound to localhost on the same VM)
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_MS=300000

# Translation layer
SARVAM_API_KEY=

# Optional Slack escalation integration
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
