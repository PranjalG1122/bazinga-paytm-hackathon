{
  "name": "server",
  "version": "1.0.0",
  "description": "Layered Node.js TypeScript backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "test": "npm run build && node --test dist/**/*.test.js",
    "telegram:webhook:set": "npm run build && node dist/scripts/telegram-setup.js set",
    "telegram:webhook:info": "npm run build && node dist/scripts/telegram-setup.js info",
    "telegram:webhook:delete": "npm run build && node dist/scripts/telegram-setup.js delete"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "nodemon": "^3.1.14",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
